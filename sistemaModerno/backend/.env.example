# Copie para backend/.env e preencha. O arquivo .env NÃO deve ser commitado.
#
# Use a conexão do Session Pooler do Supabase (Project Settings > Database >
# Connection string > Session pooler). A conexão direta (db.<ref>.supabase.co)
# costuma funcionar só via IPv6.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<senha-do-banco>

# Segredo para assinar os tokens JWT (mínimo 32 caracteres, aleatório).
JWT_SECRET=<gere-um-valor-aleatorio-com-32-ou-mais-caracteres>

# Origens permitidas para o frontend (separadas por vírgula).
CORS_ORIGENS=http://localhost:5173
